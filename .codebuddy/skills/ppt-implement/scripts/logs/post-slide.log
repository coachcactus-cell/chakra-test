t statusColor: Record<string, string> = {\n    low: \"var(--info)\",\n    mid: \"var(--success)\",\n    high: \"var(--warning)\",\n  };\n\n  return (\n    <main className=\"min-h-screen bg-background\">\n      {/* 顶部 */}\n      <nav className=\"border-b border-border px-4 py-3\">\n        <div className=\"container mx-auto flex items-center justify-between\">\n          <span\n            className=\"text-lg font-semibold\"\n            style={{ color: \"var(--primary)\" }}\n          >\n            脈輪測試結果\n          </span>\n        </div>\n      </nav>\n\n      <section className=\"container mx-auto max-w-2xl px-4 py-10\">\n        <FadeIn>\n          <h1 className=\"text-center text-3xl font-bold\" style={{ color: \"var(--foreground)\" }}>\n            你的脈輪能量分析\n          </h1>\n          <p\n            className=\"mt-2 text-center text-sm\"\n            style={{ color: \"var(--muted-foreground)\" }}\n          >\n            圖表顯示每個脈輪能量中心的活躍程度\n          </p>\n        </FadeIn>\n\n        {/* 图例 */}\n        <FadeIn delay={0.1}>\n          <div className=\"mt-6 flex items-center justify-center gap-4 text-xs\">\n            <span style={{ color: \"var(--info)\" }}>● 不活躍</span>\n            <span style={{ color: \"var(--success)\" }}>● 適度活躍</span>\n            <span style={{ color: \"var(--warning)\" }}>● 過度活躍</span>\n          </div>\n        </FadeIn>\n\n        {/* 七个脉轮结果卡片 */}\n        <Stagger className=\"mt-8 space-y-4\">\n          {results.map((r) => (\n            <Card key={r.chakra.id} className=\"overflow-hidden border-border\">\n              <CardContent className=\"p-4\">\n                {/* 标题行 */}\n                <div className=\"mb-2 flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2\">\n                    <div\n                      className=\"size-3 rounded-full\"\n                      style={{ backgroundColor: r.chakra.color }}\n                    />\n                    <span className=\"text-sm font-semibold\" style={{ color: \"var(--foreground)\" }}>\n                      {r.chakra.nameZh}\n                    </span>\n                    <span className=\"text-xs\" style={{ color: \"var(--muted-foreground)\" }}>\n                      {r.chakra.sanskrit}\n                    </span>\n                  </div>\n                  <span\n                    className=\"rounded-full px-2 py-0.5 text-xs font-medium\"\n                    style={{\n                      backgroundColor: `color-mix(in oklch, ${statusColor[r.status.level]} 15%, transparent)`,\n                      color: statusColor[r.status.level],\n                    }}\n                  >\n                    {r.status.label}\n                  </span>\n                </div>\n\n                {/* 能量条 */}\n                <div className=\"h-4 w-full overflow-hidden rounded-full bg-[oklch(0.92_0_0)] dark:bg-[oklch(0.22_0_0)]\">\n                  <div\n                    className=\"h-full rounded-full transition-all duration-700\"\n                    style={{\n                      width: `${r.percentage}%`,\n                      backgroundColor: r.chakra.color,\n                      opacity: 0.85,\n                    }}\n                  />\n                </div>\n\n                {/* 分数与说明 */}\n                <div className=\"mt-2 flex items-end justify-between\">\n                  <p className=\"text-xs\" style={{ color: \"var(--muted-foreground)\" }}>\n                    {r.chakra.description}\n                  </p>\n                  <span className=\"text-xs tabular-nums\" style={{ color: \"var(--muted-foreground)\" }}>\n                    {r.score} / {MAX_PER_CHAKRA}\n                  </span>\n                </div>\n              </CardContent>\n            </Card>\n          ))}\n        </Stagger>\n\n        {/* 建议区域 */}\n        <FadeIn delay={0.3}>\n          <div\n            className=\"mt-10 rounded-xl border p-6\"\n            style={{ borderColor: \"var(--border)\", backgroundColor: \"var(--muted)\" }}\n          >\n            <h2 className=\"text-lg font-semibold\" style={{ color: \"var(--foreground)\" }}>\n              改善建議\n            </h2>\n            <ul className=\"mt-3 space-y-2 text-sm\" style={{ color: \"var(--muted-foreground)\" }}>\n              {results\n                .filter((r) => r.status.level === \"low\")\n                .map((r) => (\n                  <li key={r.chakra.id}>\n                    • <span className=\"font-medium\" style={{ color: \"var(--info)\" }}>\n                      {r.chakra.nameZh}\n                    </span> 目前不活躍，建議透過冥想、瑜伽或能量療癒來開啟此脈輪。\n                  </li>\n                ))}\n              {results\n                .filter((r) => r.status.level === \"high\")\n                .map((r) => (\n                  <li key={r.chakra.id}>\n                    • <span className=\"font-medium\" style={{ color: \"var(--warning)\" }}>\n                      {r.chakra.nameZh}\n                    </span> 目前過度活躍，建議練習平衡的呼吸法與靜坐，讓能量回到適度狀態。\n                  </li>\n                ))}\n              {results.every((r) => r.status.level === \"mid\") && (\n                <li>恭喜！你的七個脈輪皆處於適度活躍的狀態，請持續保持身心平衡。</li>\n              )}\n            </ul>\n          </div>\n        </FadeIn>\n\n        {/* 重新测试 */}\n        <div className=\"mt-8 mb-12 text-center\">\n          <Button\n            variant=\"outline\"\n            className=\"cursor-pointer\"\n            onClick={() => {\n              sessionStorage.removeItem(\"chakra_answers\");\n              navigate(\"/quiz\");\n            }}\n          >\n            重新測試\n          </Button>\n        </div>\n      </section>\n\n      {/* 页脚 */}\n      <footer\n        className=\"border-t border-border px-4 py-6 text-center text-sm\"\n        style={{ color: \"var(--muted-foreground)\" }}\n      >\n        <p>脈輪測試 · 參考 Eclectic Energies 脈輪測驗</p>\n      </footer>\n    </main>\n  );\n}\n"},"tool_response":"Successfully created a