n className=\"text-xs\" style={{ color: \"var(--muted-foreground)\" }}>\n            {answeredCount}/{TOTAL}\n          </span>\n        </div>\n        <div className=\"mt-2\">\n          <Progress value={progress} className=\"h-1.5\" />\n        </div>\n      </nav>\n\n      <div ref={topRef} />\n\n      {/* 说明 */}\n      <section className=\"px-3 pt-4 pb-2\">\n        <FadeIn>\n          <p className=\"text-xs leading-relaxed\" style={{ color: \"var(--muted-foreground)\" }}>\n            共 {TOTAL} 题，从「完全没有」到「感覺強烈」选择最符合你的程度。\n          </p>\n        </FadeIn>\n      </section>\n\n      {/* 题目列表 - 手机优先：单列 */}\n      <section className=\"px-3 pb-40\">\n        <div className=\"space-y-3\">\n          {CHAKRAS.map((chakra) => {\n            const chakraQuestions = QUESTIONS.filter(q => q.chakraId === chakra.id);\n            return (\n              <div key={chakra.id}>\n                {/* 脉轮分组标题 */}\n                <div\n                  className=\"mb-2 mt-4 flex items-center gap-2 rounded-lg px-2 py-1.5\"\n                  style={{ backgroundColor: `color-mix(in oklch, ${chakra.color} 12%, var(--background))` }}\n                >\n                  <div className=\"size-2.5 rounded-full\" style={{ backgroundColor: chakra.color }} />\n                  <span className=\"text-xs font-semibold\" style={{ color: \"var(--foreground)\" }}>\n                    {chakra.nameZh}\n                  </span>\n                </div>\n\n                {chakraQuestions.map((q) => (\n                  <div\n                    id={`q-${q.id}`}\n                    key={q.id}\n                    className=\"rounded-xl border border-border bg-card p-3\"\n                  >\n                    <p className=\"mb-2.5 text-sm font-medium leading-relaxed\" style={{ color: \"var(--foreground)\" }}>\n                      {q.id}. {q.text}\n                    </p>\n                    {/* 手机版：评分按钮放在一行，可横向滚动 */}\n                    <div className=\"flex gap-1.5 overflow-x-auto pb-1\">\n                      {SCORE_LABELS.filter(Boolean).map((label, i) => {\n                        const score = i + 1;\n                        const checked = answers[q.id] === score;\n                        return (\n                          <button\n                            key={score}\n                            type=\"button\"\n                            onClick={() => handleChange(q.id, score)}\n                            className=\"shrink-0 cursor-pointer rounded-lg border px-2.5 py-1.5 text-xs transition-all whitespace-nowrap\"\n                            style={{\n                              borderColor: checked ? \"var(--primary)\" : \"var(--border)\",\n                              backgroundColor: checked\n                                ? \"color-mix(in oklch, var(--primary) 12%, var(--background))\"\n                                : \"transparent\",\n                              color: checked ? \"var(--primary)\" : \"var(--muted-foreground)\",\n                            }}\n                          >\n                            {label}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n                ))}\n              </div>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* 底部固定提交栏 */}\n      <div\n        className=\"fixed bottom-0 left-0 right-0 z-30 border-t border-border bg-background/90 backdrop-blur-md px-3 py-3\"\n      >\n        {answeredCount < TOTAL && (\n          <p className=\"mb-2 text-center text-xs\" style={{ color: \"var(--muted-foreground)\" }}>\n            已完成 {answeredCount}/{TOTAL} 题\n          </p>\n        )}\n        <Button\n          size=\"lg\"\n          className=\"w-full cursor-pointer text-base\"\n          style={{\n            backgroundColor: answeredCount >= TOTAL ? \"var(--primary)\" : \"var(--muted)\",\n            color: answeredCount >= TOTAL ? \"var(--primary-foreground)\" : \"var(--muted-foreground)\",\n          }}\n          disabled={answeredCount < TOTAL}\n          onClick={handleSubmit}\n        >\n          查看結果\n        </Button>\n      </div>\n    </main>\n  );\n}\n"},"tool_response":"Successfully overwrote file: /workspace/frontend/src/pages/Quiz.tsx","call_id":"chatcmpl-tool-8eff47a463ab59e1","tool_use_id":"chatcmpl-tool-8eff47a463ab59e1","permission_mode":"dontAsk","client":"CLI","version":"2.94.0","generation_id":"c5c9597fa8ae43c3a27bf4e5eafa8517","model":"hy3-preview"}
