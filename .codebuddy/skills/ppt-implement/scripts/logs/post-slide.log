\n      {/* 题目列表 */}\n      <section className=\"container mx-auto px-4 py-8\">\n        <FadeIn>\n          <h1 className=\"mb-6 text-2xl font-bold\" style={{ color: \"var(--foreground)\" }}>\n            脈輪測驗\n          </h1>\n          <p className=\"mb-6 text-sm\" style={{ color: \"var(--muted-foreground)\" }}>\n            本測驗共 {TOTAL} 個問題，每個問題依照程度回答，從「完全沒有」到「感覺強烈」。\n            誠實回答問題，以獲得準確的結果。\n          </p>\n        </FadeIn>\n\n        <div className=\"space-y-6\">\n          {CHAKRAS.map((chakra) => {\n            const chakraQuestions = QUESTIONS.filter(q => q.chakraId === chakra.id);\n            return (\n              <FadeIn key={chakra.id} delay={chakra.id * 0.05}>\n                {/* 脉轮分组标题 */}\n                <div\n                  className=\"mb-3 flex items-center gap-2 rounded-lg px-3 py-2\"\n                  style={{ backgroundColor: `color-mix(in oklch, ${chakra.color} 12%, var(--background))` }}\n                >\n                  <div className=\"size-3 rounded-full\" style={{ backgroundColor: chakra.color }} />\n                  <span className=\"text-sm font-semibold\" style={{ color: \"var(--foreground)\" }}>\n                    {chakra.nameZh}（{chakra.sanskrit}）\n                  </span>\n                </div>\n\n                {/* 该脉轮的题目 */}\n                <div className=\"space-y-4 pl-2\">\n                  {chakraQuestions.map((q, idx) => (\n                    <div\n                      key={q.id}\n                      className=\"rounded-xl border border-border bg-card p-4\"\n                    >\n                      <p className=\"mb-3 text-sm font-medium\" style={{ color: \"var(--foreground)\" }}>\n                        {q.id}. {q.text}\n                      </p>\n                      <div className=\"flex flex-wrap gap-2\">\n                        {SCORE_LABELS.filter(Boolean).map((label, i) => {\n                          const score = i + 1;\n                          const checked = answers[q.id] === s